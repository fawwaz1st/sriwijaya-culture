# Variabel lingkungan
#
# Salin berkas ini menjadi .env.local lalu isi salah satu kunci.
# Tanpa kunci, asisten tetap berjalan dalam mode arsip langsung.
# Situs tidak pernah menampilkan jawaban kosong.

# --- Penyedia utama (opsional, pilih salah satu) -------------------------
# OpenRouter: format kunci harus sk-or-v1-<64 hex>
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Groq: format kunci harus diawali gsk_
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Together
# TOGETHER_API_KEY=
# TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# --- Situs --------------------------------------------------------------
# Dipakai untuk sitemap dan metadata Open Graph.
NEXT_PUBLIC_SITE_URL=https://sriwijaya-culture.vercel.app

# Variabel lingkungan — salin menjadi .env.local lalu isi.
#
# .env.local di-ignore oleh .gitignore (pola `.env*.local`), jadi kunci
# tidak pernah masuk repositori. Untuk produksi di Vercel, isi nilai yang
# sama lewat Project Settings > Environment Variables.
#
# Tanpa kunci apa pun, situs tetap berjalan: Asisten Sari menjawab dalam
# mode arsip langsung (ringkasan dokumen dengan rujukan sah), dan tidak
# pernah menampilkan jawaban kosong.

# --- Groq (penyedia utama, disarankan) ----------------------------------
# Format kunci: diawali `gsk_`
GROQ_API_KEY=
# Model utama. Kualitas dulu, kecepatan kemudian.
GROQ_MODEL=openai/gpt-oss-120b
# Dicoba kalau model utama gagal atau dihentikan penyedia.
GROQ_MODEL_CADANGAN=llama-3.3-70b-versatile
# Model paling ringan, dipakai sebagai upaya terakhir.
GROQ_MODEL_CEPAT=openai/gpt-oss-20b

# --- Alternatif: OpenRouter ---------------------------------------------
# Format kunci: sk-or-v1-<64 karakter hex>
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemma-4-31b-it:free

# --- Alternatif: Together -----------------------------------------------
# TOGETHER_API_KEY=
# TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# --- Situs --------------------------------------------------------------
# Dipakai untuk sitemap dan metadata Open Graph.
NEXT_PUBLIC_SITE_URL=https://sriwijaya-culture.vercel.app
